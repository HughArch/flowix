# Dependencies
node_modules/
.pnp
.pnp.js
.pnpm-store/

# Build outputs
dist/
.build/
dsh-appserver/bin/
app/target/
app/flownote-desktop/target/
app/flownote-desktop/binaries/
app/flownote-desktop/nsis/flownote-installer-helper.exe

# Tauri-generated native scaffolds
# gen/android 需要入库: 含国内 maven 镜像、BuildTask npm 解析补丁及后续
# MainActivity/applicationId 定制; 构建产物由 gen/android/.gitignore 排除。
app/flownote-desktop/gen/schemas/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dev launcher runtime artifacts
*.pid
*.stderr.path

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Env
.env
.env.local
.env.*.local

# Tauri / Rust
**/*.rs.bk
Cargo.lock.bak
# Rust 静态库产物 ── 仅 cargo build 生成，不应入库（曾经误提交过 libflownote_anthropic_check.rlib）
*.rlib

# Test / cache
coverage/
.nyc_output/
*.tsbuildinfo

# Local artifacts
test.json
app/flownote-desktop/tauri*.production.local.json

# Cloudflare / Wrangler local dev state (miniflare cache, R2 sqlite/blobs)
.wrangler/

# Apple Developer ID signing (scripts live in scripts/apple-signing/,
# but the actual keys/certs must never be committed)
*.p12
*.csr
*.cer
flownote_devid.key
.app-store-connect/
developerID_application.*
# iOS TestFlight pipeline additions (Apple Distribution cert,
# App Store Connect API key, App Store provisioning profile)
*.p8
*.mobileprovision
appstoreconnect/

# WorkBuddy agent workspace data
.workbuddy/

# Local sync credentials (FNS API token etc.) — never commit
.local/
