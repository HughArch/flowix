<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS Info.plist overlay ── Tauri builds the full Info.plist 自动合上基础字段
  (CFBundleIdentifier / CFBundleName / LSMinimumSystemVersion 等), 这里只
  放 Flownote 特有的:
    - CFBundleURLTypes: 注册 `flownote://` URL scheme, 让 OS 把浏览器 / 终端里
      `flownote://memo/<id>` 链接路由到 Flownote (launchd / LaunchServices 机制)
    - 文件打开关联由 fileAssociations 声明，包括 Markdown 和 public.data 通用文件

  dev (`tauri dev`) 不会把它作为 app bundle plist 读取；`build.rs` 会把其中的
  本地化字段嵌入调试二进制。打包后由 `tauri-build` 合并进 app bundle。跟
  `app/flownote-desktop/tauri.conf.json` 里的 `bundle.macOS.infoPlist` 路径对应。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.flownote.app.deeplink</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>flownote</string>
			</array>
			</dict>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Flownote</string>
	<key>CFBundleName</key>
	<string>Flownote</string>
	<!-- Keep AppKit/WKWebView system menu strings aligned with macOS's
	     preferred language. Tauri's generated plist otherwise defaults the
	     bundle development region to English, which makes the native editor
	     context menu appear in English even on a Chinese macOS system. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hans</string>
		<string>en</string>
	</array>
</dict>
</plist>
